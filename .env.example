# github-widget environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server listen port
PORT=3000

# GitHub Personal Access Token (optional but recommended)
# Without a token: 60 requests/hour per IP (public repos only)
# With a token:    5,000 requests/hour
#
# How to get a GitHub token:
#   1. Go to https://github.com/settings/tokens (sign in to GitHub)
#   2. Click "Generate new token" → "Generate new token (classic)"
#   3. Give it a name (e.g. "github-widget")
#   4. No scopes are needed for public repository read access
#      (leave all checkboxes unchecked)
#   5. Click "Generate token" at the bottom
#   6. Copy the token (starts with ghp_) — you won't see it again
#   7. Paste it below
#
# For a fine-grained token instead:
#   1. Go to https://github.com/settings/personal-access-tokens/new
#   2. Set a name and expiration
#   3. Under "Repository access" choose "Public Repositories (read-only)"
#   4. No additional permissions are needed
#   5. Generate and copy the token (starts with github_pat_)
GITHUB_TOKEN=

# GitHub API base URL (change only if using GitHub Enterprise)
GITHUB_API_URL=https://api.github.com

# Cache entry time-to-live
CACHE_TTL=10m

# Maximum cached entries
CACHE_MAX_ENTRIES=1000

# Log level: debug, info, warn, error
LOG_LEVEL=info
